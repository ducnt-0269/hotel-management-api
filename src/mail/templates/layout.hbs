{{!--
  Shared MJML shell for every mail: preheader, brand bar, white card, footer.
  `{{{body}}}` is the rendered template, injected by the mailer's `layout`
  option. MJML compiles the result to the table markup Outlook needs, and
  Handlebars escapes every {{value}} on the way in. Static copy comes from
  src/i18n/<lang>/mail.json through the `t` helper, in the language the
  context's `i18nLang` names.
--}}
<mjml lang='{{i18nLang}}'>
  <mj-head>
    <mj-title>{{subject}}</mj-title>
    <mj-preview>{{preview}}</mj-preview>
    <mj-attributes>
      <mj-all font-family='Helvetica Neue, Helvetica, Arial, sans-serif' />
      <mj-text font-size='15px' line-height='24px' color='#27272a' />
    </mj-attributes>
    <mj-style>
      .link-fallback div { word-break: break-all; }
    </mj-style>
    {{!
      Styles for the raw HTML inside mj-text / mj-table, which MJML does not
      style itself. `inline` makes MJML copy them onto each element, since
      many mail clients drop a <style> block.
    }}
    <mj-style inline='inline'>
      .pill { display: inline-block; padding: 4px 12px; border-radius: 999px;
      font-size: 12px; line-height: 18px; font-weight: 700; letter-spacing:
      0.5px; text-transform: uppercase; } .pill-approved { background-color:
      #dcfce7; color: #15803d; } .pill-rejected { background-color: #fee2e2;
      color: #b91c1c; } .pill-expired { background-color: #f4f4f5; color:
      #52525b; } .reason { border-left: 4px solid #b91c1c; background-color:
      #fef2f2; padding: 12px 16px; border-radius: 0 8px 8px 0; color: #27272a; }
      .reason-label { font-size: 12px; font-weight: 700; color: #b91c1c;
      letter-spacing: 0.5px; text-transform: uppercase; padding-bottom: 4px; }
      .summary-label { color: #71717a; padding-left: 0; } .summary-value {
      text-align: right; padding-right: 0; } .summary-total td { border-top: 1px
      solid #e4e4e7; padding-top: 12px; font-weight: 700; color: #18181b; }
      .summary-total .summary-value { font-size: 16px; }
    </mj-style>
  </mj-head>

  <mj-body background-color='#f4f4f5' width='600px'>
    <mj-section padding='32px 24px 16px'>
      <mj-column>
        <mj-text
          font-size='17px'
          font-weight='700'
          color='#0f766e'
          letter-spacing='1px'
        >
          HOTEL MANAGEMENT
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section
      background-color='#ffffff'
      border-radius='12px'
      padding='40px 32px'
    >
      <mj-column>
        {{{body}}}
      </mj-column>
    </mj-section>

    <mj-section padding='20px 24px 32px'>
      <mj-column>
        <mj-text
          font-size='12px'
          line-height='20px'
          color='#a1a1aa'
          align='center'
        >
          {{t 'mail.layout.footer'}}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>