<mj-text
  font-size="22px"
  font-weight="700"
  color="#18181b"
  padding-bottom="16px"
>
  {{t 'mail.activation.heading'}}
</mj-text>

<mj-text padding-bottom="8px">{{t 'mail.activation.greeting' this}}</mj-text>

<mj-text padding-bottom="28px">
  {{t 'mail.activation.body'}}
</mj-text>

<mj-button
  href="{{url}}"
  background-color="#0f766e"
  color="#ffffff"
  font-size="16px"
  font-weight="600"
  inner-padding="14px 28px"
  border-radius="8px"
  align="left"
  padding="0 25px 28px"
>
  {{t 'mail.activation.button'}}
</mj-button>

<mj-text font-size="13px" color="#71717a" padding-bottom="4px">
  {{t 'mail.activation.fallback'}}
</mj-text>
<mj-text
  font-size="13px"
  color="#0f766e"
  css-class="link-fallback"
  padding-bottom="28px"
>
  {{ url }}
</mj-text>

<mj-divider border-width="1px" border-color="#e4e4e7" padding="0 25px 24px" />

<mj-text font-size="13px" color="#71717a">
  {{t 'mail.activation.expiry' this}}
</mj-text>
