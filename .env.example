NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=hotel
DB_PASSWORD=hotel
DB_NAME=hotel

# Redis, backing the BullMQ queues
REDIS_HOST=localhost
REDIS_PORT=6379

# Mail — Mailpit swallows everything and shows it at http://localhost:8025
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM="Hotel Management <no-reply@hotel.local>"

# Auth
JWT_SECRET=change-me-in-your-own-env
JWT_EXPIRES_IN=1d

# Stripe — keys of a sandbox (Dashboard → Developers → API keys). To have a
# dev payment reach the webhook, run the Stripe CLI container:
#   docker compose --profile stripe up -d stripe-cli
# and copy the whsec_ from `docker compose logs stripe-cli` below.
STRIPE_SECRET_KEY=sk_test_change-me
STRIPE_WEBHOOK_SECRET=whsec_change-me
PAYMENT_SUCCESS_URL=http://localhost:3000/api/docs
PAYMENT_CANCEL_URL=http://localhost:3000/api/docs
