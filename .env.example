NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=hotel
DB_PASSWORD=hotel
DB_NAME=hotel

# Redis, backing the BullMQ queues
REDIS_HOST=localhost
REDIS_PORT=6379

# Mail — Mailpit swallows everything and shows it at http://localhost:8025
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM="Hotel Management <no-reply@hotel.local>"

# Auth
JWT_SECRET=change-me-in-your-own-env
JWT_EXPIRES_IN=1d
